{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/web/landing.html"
    },
    {
      "source": "/dashboard",
      "destination": "/web/index.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/web/assets/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/web/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/web/js/$1"
    },
    {
      "source": "/data/(.*)",
      "destination": "/web/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
