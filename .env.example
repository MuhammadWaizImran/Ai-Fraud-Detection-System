# Azure Event Hubs Configuration (Optional for Cloud Streaming)
AZURE_EVENT_HUBS_CONNECTION_STRING="Endpoint=sb://your-eventhub.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key"
AZURE_EVENT_HUB_NAME="finra-market-trades"

# Azure Databricks Configuration
DATABRICKS_HOST="https://adb-your-workspace.azuredatabricks.net"
DATABRICKS_TOKEN="dapi_your_token"
DATABRICKS_CLUSTER_ID="your_cluster_id"

# CoinGecko Oracle API (Optional, Public endpoint works without key)
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
